{
  "name": "universe-bot-catalog1",
  "main": "./worker.js",
  "compatibility_date": "2026-08-22",
  "vars": {
    "ZOHO_ALLOWED_ADDRESS": "consolidatestores@zohomail.com"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_TOKENS",
      "id": "3e03e2c57f884de5a74b9fb33b66c9ba"
    }
  ]
}
